{
  "dependencies": {
    "nanostores": "^1.0.1"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/postcss": "^4.1.12",
    "autoprefixer": "^10.4.21",
    "parcel": "^2.15.4",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.12"
  },
  "targets": {
    "browser": {
      "context": "browser",
      "includeNodeModules": true,
      "distDir": "dist",
      "outputFormat": "esmodule",
      "isLibrary": false,
      "optimize": true
    }
  },
  "name": "cymatics-art",
  "version": "1.0.0",
  "private": true,
  "description": "Digital cymatics with reflecting boundaries \u2014 a single-file web app",
  "scripts": {
    "build": "parcel build src/index.html --no-source-maps --dist-dir dist",
    "dev": "parcel src/index.html --port 1234",
    "test": "node --test tests/*.test.mjs",
    "serve": "python3 -m http.server 8000 --directory dist"
  }
}
